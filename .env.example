# Copy this file to .env and fill in real values for your machine.
# Never commit .env — it is listed in .gitignore (CLAUDE.md ch.12).

# Which settings module manage.py/wsgi/asgi resolve to.
DJANGO_SETTINGS_MODULE=config.settings.development

DJANGO_SECRET_KEY=change-me-to-a-random-50-character-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — CLAUDE.md ch.10 (never SQLite in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/news_db

# Redis — cache + Celery broker (CLAUDE.md ch.13)
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Production-only (SMTP, HTTPS enforcement) — leave blank in development
DJANGO_SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds — defaults to 31536000 (1 year) if unset. Consider
# starting with a short value (e.g. 300) for the first few days after
# enabling HTTPS: a browser that receives a long HSTS header will refuse to
# visit the site over plain HTTP again for that entire duration, even if
# something's misconfigured — only raise it back to a year once HTTPS is
# confirmed solid.
DJANGO_SECURE_HSTS_SECONDS=31536000
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
